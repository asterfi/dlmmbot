# /etc/dlmmbot/bot.env  — owner root, group dlmmbot, mode 0640.
# Never inside the repo directory; never readable by other users (e.g. an AI agent's account).

# Privy server wallet (bot never holds the Solana key). Produced by deploy/hardened/privy/setup.mjs.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_WALLET_ID=
PRIVY_WALLET_ADDRESS=
PRIVY_BOT_SIGNER_ID=
PRIVY_BOT_AUTH_KEY=
WALLET_PUBKEY=            # same as PRIVY_WALLET_ADDRESS (dashboard display)
COLD_WALLET_ADDRESS=      # truth-pnl: transfers here count as withdrawals, not losses

# Market data / execution
RPC_URL=
RPC_URL_FALLBACK=
JUPITER_API_KEY=
GMGN_API_KEY=
TYPESAFE_API_KEY=         # Jev (Typesafe System One) master gate; absent = rules only

# Alerts + daily truth-P&L report
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dashboard (loopback only; expose via Caddyfile.example)
DASH_TOKEN=               # >= 24 random chars, e.g. openssl rand -hex 24
DASH_HOST=127.0.0.1
DASH_PORT=8787

FARMER_MODE=paper         # set to live only together with [exec].mode = "live"
FARMER_DB_PATH=/var/lib/dlmmbot/data/farmer.db
