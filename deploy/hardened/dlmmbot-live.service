[Unit]
Description=dlmmbot DLMM LP bot (live process, paper/live mode per config)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dlmmbot
Group=dlmmbot
WorkingDirectory=/opt/dlmmbot-live
EnvironmentFile=/etc/dlmmbot/bot.env
Environment=HOME=/var/lib/dlmmbot
Environment=XDG_CACHE_HOME=/var/lib/dlmmbot/.cache
Environment=npm_config_cache=/var/lib/dlmmbot/.npm-cache
ExecStart=/opt/dlmmbot-live/node_modules/.bin/tsx src/cli.ts run
Restart=on-failure
RestartSec=15

# Hardening — the bot reads its own code/config from /opt/dlmmbot-live
# (read-only to it, see file ownership) and writes only under /var/lib/dlmmbot.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/dlmmbot
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=1500M

[Install]
WantedBy=multi-user.target
